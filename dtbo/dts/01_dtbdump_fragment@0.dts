			panel3@2 {
				compatible = "o16u_44_0f_0c_dsc_vdo,lcm";
				reg = <0x02>;
				reset-gpios = <0xffffffff 0x5a 0x00>;
				dvdd-gpios = <0xffffffff 0xb8 0x00>;
				amoled-vci-supply = <0xffffffff>;
				amoled-vio18-supply = <0xffffffff>;
				res-switch = <0x02>;
				rc-enable = <0x01>;
				pinctrl-names = "default";

				port {

					endpoint {
						remote-endpoint = <0x15>;
						phandle = <0x1a>;
					};
				};
			};

			panel4@3 {
				compatible = "o16u_42_02_0d_dsc_vdo,lcm";
				reg = <0x03>;
				reset-gpios = <0xffffffff 0x5a 0x00>;
				dvdd-gpios = <0xffffffff 0xb8 0x00>;
				amoled-vci-supply = <0xffffffff>;
				amoled-vio18-supply = <0xffffffff>;
				res-switch = <0x02>;
				rc-enable = <0x01>;
				pinctrl-names = "default";

				port {

					endpoint {
						remote-endpoint = <0x16>;
						phandle = <0x1b>;
					};
				};
			};

			panel5@4 {
				compatible = "o16u_virtual_default_dsc_vdo,lcm";
				reg = <0x04>;
				reset-gpios = <0xffffffff 0x5a 0x00>;
				dvdd-gpios = <0xffffffff 0xb8 0x00>;
				amoled-vci-supply = <0xffffffff>;
				amoled-vio18-supply = <0xffffffff>;
				res-switch = <0x02>;
				rc-enable = <0x01>;
				pinctrl-names = "default";

				port {

					endpoint {
						remote-endpoint = <0x17>;
						phandle = <0x1c>;
					};
				};
			};

			ports {

				port {

					endpoint {
						remote-endpoint = <0x18>;
						phandle = <0x13>;
					};

					endpoint2 {
						remote-endpoint = <0x19>;
						phandle = <0x14>;
					};

					endpoint3 {
						remote-endpoint = <0x1a>;
						phandle = <0x15>;
					};

					endpoint4 {
						remote-endpoint = <0x1b>;
						phandle = <0x16>;
					};

					endpoint5 {
						remote-endpoint = <0x1c>;
						phandle = <0x17>;
					};
				};
			};
		};
	};

	fragment@13 {
