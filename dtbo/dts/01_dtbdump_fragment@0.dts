/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			bootargs_ext = [00];
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			thermal-message {
				board-sensor = "VIRTUAL-SENSOR";
				phandle = <0x72>;
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			pd-vbus-upper-bound = <0x895440>;
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;

			aw882xx@35 {
				compatible = "awinic,aw882xx_smartpa";
				#sound-dai-cells = <0x00>;
				reg = <0x35>;
				reset-gpio = <0xffffffff 0xc1 0x00>;
				irq-gpio = <0xffffffff 0x11 0x00>;
				fsm,rst-gpio = <0xffffffff 0xc1 0x00>;
				fsm,irq-gpio = <0xffffffff 0x11 0x00>;
				sync-load = <0x01>;
				vcalb_half = <0x01>;
				sound-channel = <0x00>;
				aw-re-min = <0x157c>;
				aw-re-max = <0x251c>;
				status = "okay";
				phandle = <0x04>;
			};

			aw882xx@34 {
				compatible = "awinic,aw882xx_smartpa";
				#sound-dai-cells = <0x00>;
				reg = <0x34>;
				reset-gpio = <0xffffffff 0xc0 0x00>;
				irq-gpio = <0xffffffff 0x0a 0x00>;
				fsm,rst-gpio = <0xffffffff 0xc0 0x00>;
				fsm,irq-gpio = <0xffffffff 0x0a 0x00>;
				sync-load = <0x01>;
				vcalb_half = <0x01>;
				sound-channel = <0x01>;
				aw-re-min = <0x157c>;
				aw-re-max = <0x251c>;
				status = "okay";
				phandle = <0x05>;
			};

			sia91xx_i2c@R {
				compatible = "si,sia91xx-i2c";
				#sound-dai-cells = <0x00>;
				reg = <0x6c>;
				si,sipa-dev = <0x01>;
				status = "okay";
				phandle = <0x07>;
			};

			sia91xx_i2c@L {
				compatible = "si,sia91xx-i2c";
				#sound-dai-cells = <0x00>;
				reg = <0x6d>;
				si,sipa-dev = <0x02>;
				status = "okay";
				phandle = <0x06>;
			};

			et7480@42 {
				status = "ok";
				compatible = "mediatek,et7480-audioswitch";
				reg = <0x42>;
				phandle = <0x03>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			et7480-i2c-handle = <0x03>;
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			mediatek,spk-i2s = <0x19 0x18>;

			mediatek,speaker-codec {
				sound-dai = <0x04 0x05>;
			};

			mediatek,speaker-codec-fsm {
				sound-dai = <0x04>;
			};

			mediatek,speaker-codec-sia {
				sound-dai = <0x06 0x07>;
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {

			sia91xx@R {
				compatible = "si,sia91xx";
				si,si_pa_type = "sia9187";
				si,si_pa_irq = <0xffffffff 0x11 0x00>;
				si,si_pa_reset = <0xffffffff 0xc1 0x00>;
				pinctrl-names = "si_pa_gpio";
				pinctrl-0 = <0x08>;
				si,si_pa_disable_pin = <0x00>;
				channel_num = <0x01>;
				phandle = <0x01>;
			};

			sia91xx@L {
				compatible = "si,sia91xx";
				si,si_pa_type = "sia9187";
				si,si_pa_irq = <0xffffffff 0x0a 0x00>;
				si,si_pa_reset = <0xffffffff 0xc0 0x00>;
				pinctrl-names = "si_pa_gpio";
				pinctrl-0 = <0x09>;
				si,si_pa_disable_pin = <0x00>;
				channel_num = <0x00>;
				phandle = <0x02>;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			si,sia81xx-max-num = <0x02>;
			si,is_digital_pa = <0x01>;
			si,sia81xx-aux-devs = <0x06 0x07>;
			si,sia81xx-aux-devs-prefix = "SpkrLeft", "SpkrRight";
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {

			sia91xx_gpio_R {
				phandle = <0x08>;

				pins_cmd_dat {
					pinmux = <0xc100>;
					slew-rate = <0x01>;
					bias-disable;
				};
			};

			sia91xx_gpio_L {
				phandle = <0x09>;

				pins_cmd_dat {
					pinmux = <0xc000>;
					slew-rate = <0x01>;
					bias-disable;
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "lcd_bias_enp1_gpio", "lcd_bias_enp0_gpio", "lcd_bias_enn1_gpio", "lcd_bias_enn0_gpio", "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te", "lcm_led_en1_gpio", "lcm_led_en0_gpio";
			pinctrl-0 = <0x0a>;
			pinctrl-1 = <0x0b>;
			pinctrl-2 = <0x0c>;
			pinctrl-3 = <0x0d>;
			pinctrl-4 = <0x0e>;
			pinctrl-5 = <0x0f>;
			pinctrl-6 = <0x10>;
			pinctrl-7 = <0x11>;
			pinctrl-8 = <0x12>;
			status = "okay";
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {

			lcd-bias-enp1-gpio {
				phandle = <0x0a>;

				pins-cmd-dat {
					pinmux = <0x9500>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcd-bias-enp0-gpio {
				phandle = <0x0b>;

				pins-cmd-dat {
					pinmux = <0x9500>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcd-bias-enn1-gpio {
				phandle = <0x0c>;

				pins-cmd-dat {
					pinmux = <0x9500>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcd-bias-enn0-gpio {
