				pins-cmd-dat {
					pinmux = <0x9500>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm-rst-out1-gpio {
				phandle = <0x0e>;

				pins-cmd-dat {
					pinmux = <0x5a00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm-rst-out0-gpio {
				phandle = <0x0f>;

				pins-cmd-dat {
					pinmux = <0x5a00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcm-dsi-te {
				phandle = <0x10>;

				pins-cmd-dat {
					pinmux = <0x5901>;
				};
			};

			lcm-led-en1-gpio {
				phandle = <0x11>;

				pins-cmd-dat {
					pinmux = <0x9500>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm-led-en0-gpio {
				phandle = <0x12>;

				pins-cmd-dat {
					pinmux = <0x9500>;
					slew-rate = <0x01>;
					output-low;
				};
			};
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "mode_te_te";
			pinctrl-0 = <0x10>;
			status = "okay";
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			panel1@0 {
				compatible = "o16u_42_02_0a_dsc_vdo,lcm";
				reg = <0x00>;
				reset-gpios = <0xffffffff 0x5a 0x00>;
				dvdd-gpios = <0xffffffff 0xb8 0x00>;
				amoled-vci-supply = <0xffffffff>;
				amoled-vio18-supply = <0xffffffff>;
				res-switch = <0x02>;
				rc-enable = <0x01>;
				pinctrl-names = "default";

				port {

					endpoint {
						remote-endpoint = <0x13>;
						phandle = <0x18>;
					};
				};
			};

			panel2@1 {
				compatible = "o16u_36_02_0b_dsc_vdo,lcm";
				reg = <0x01>;
				reset-gpios = <0xffffffff 0x5a 0x00>;
				dvdd-gpios = <0xffffffff 0xb8 0x00>;
				amoled-vci-supply = <0xffffffff>;
				amoled-vio18-supply = <0xffffffff>;
				res-switch = <0x02>;
				rc-enable = <0x01>;
				pinctrl-names = "default";

				port {

