		};

		mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0x138>;
		};

		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};

		trusty-sapu {
			compatible = "mediatek,trusty-sapu";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			power-version = <0x01>;
			datamem-type = <0x02>;
			datamem-size = <0x00 0x00>;
			iommus = <0x8d 0x120541>;
			status = "okay";
		};
	};

	nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		tee-name = "nebula";
		phandle = <0x2ac>;

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};

	hypervisor {
		compatible = "mediatek,geniezone-hyp";
		status = "disabled";
		phandle = <0x2ad>;
	};

