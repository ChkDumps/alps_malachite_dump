		mediatek,larbs-supply = <0x79 0x7a 0x6d 0x7b 0x7c 0x7d 0x7e 0x80 0x84 0x85 0x81 0x86 0x88 0x7f 0x8a 0x82 0x8b 0x8c 0x87 0x89 0x83>;
		mediatek,commons-supply = <0x6c>;
		mmqos-state = <0xc8d>;
		mmqos-log-level = <0x00>;
		clocks = <0x43 0x05>;
		clock-names = "mm";
		interconnects = <0x16 0x08 0x16 0x00 0x16 0x1a 0x16 0x19>;
		interconnect-names = "icc-bw", "icc-hrt-bw";
		vmmrc-base = <0x1ec00000>;
		vmmrc-mask = <0x2e814>;
		vmmrc-mask-bit = <0x08>;
		vmmrc-on-table = <0x2e788>;
		vmmrc-off-table = <0x2e7a8>;
		mminfra-base = <0x1e800000>;
		dvfsrc-level-base = <0x1c00f000>;
