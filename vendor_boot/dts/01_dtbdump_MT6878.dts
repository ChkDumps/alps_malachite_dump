			compatible = "mediatek,mt6878-fhctl";
			reg = <0x00 0x1000ce00 0x00 0x200 0x00 0x1000c000 0x00 0xe00 0x00 0x1000ce00 0x00 0x200 0x00 0x1000c000 0x00 0xe00 0x00 0x13fa0100 0x00 0x30 0x00 0x13fa0000 0x00 0x100 0x00 0x13fa0900 0x00 0x30 0x00 0x13fa0800 0x00 0x100 0x00 0x13fa0d00 0x00 0x30 0x00 0x13fa0c00 0x00 0x100>;

